NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL (пример; для prod — URL БД Beget/managed)
DATABASE_URL=postgresql://user:password@localhost:5432/termburg

# JWT (мин. 32 символа; сгенерировать: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_REPLACE_WITH_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=900000

# SMTP (Gmail / корпоративный)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-app-password
EMAIL_FROM=noreply@example.com

# YooKassa (Shop ID + Secret Key из личного кабинета yookassa.ru)
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key
YOOKASSA_RETURN_URL=https://termburg.ru/payment/return
# Опционально: HMAC secret из yookassa для проверки webhook-подписей
YOOKASSA_WEBHOOK_SECRET=

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# 1С-Дельфин (pull-интеграция; опционально)
DOLPHIN_API_KEY=generate-random-key-and-share-with-1c-admin
DOLPHIN_BASIC_USER=
DOLPHIN_BASIC_PASS=
# DOLPHIN_DIRECT_URL=https://<1c-host>/api
# DOLPHIN_DIRECT_KEY=
