# Скопируйте этот файл в deploy.env и заполните значениями (deploy.env в .gitignore).
# Используется скриптом deploy-production.sh.

# SSH на хостинг Beget
SSH_KEY="$HOME/.ssh/beget_termburg"
SSH_USER="your-beget-username"
SSH_HOST="your-beget-username.beget.tech"

# Абсолютный путь к корню сайта на сервере
REMOTE_DIR="/home/v/your-beget-username/termburg.ru/public_html"

# Локальный каталог со сборкой фронта
LOCAL_BUILD="frontend/build"
