# Block direct wp-login.php access (плагин WPS Hide Login заменяет URL логина на секретный slug — см. HANDOVER.md)
<Files wp-login.php>
  Require all denied
</Files>

php_value default_charset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# WordPress PHP files - serve directly (not through wp-index.php)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.php$ - [L]

# Hidden login URL — значение должно совпадать с настройкой WPS Hide Login
RewriteRule ^tb-secret-login/?$ /wp-index.php [L]

# YooKassa webhook callback — POST на /?yookassa=callback должен попасть в WP, а не в SPA fallback.
RewriteCond %{QUERY_STRING} (^|&)yookassa=callback(&|$)
RewriteRule ^.*$ /wp-index.php [L]

# WordPress API - route through wp-index.php
RewriteRule ^wp-json(.*)$ /wp-index.php [L]
RewriteRule ^termburg(.*)$ /wp-index.php [L]

# WordPress admin directory - serve files directly
RewriteRule ^wp-admin(.*)$ - [L]

# WordPress static content
RewriteRule ^wp-content(.*)$ - [L]
RewriteRule ^wp-includes(.*)$ - [L]

# Sitemaps
RewriteRule ^sitemap\.xml$ - [L]
RewriteRule ^sitemap_index\.xml$ /wp-index.php [L]
RewriteRule ^([^/]+)-sitemap\.xml$ /wp-index.php [L]

# Force HTTPS in redirects
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 301 Redirects from old WP URLs
RewriteRule ^about-kompany/?$ https://termburg.ru/about [R=301,L]
RewriteRule ^cooperation/?$ https://termburg.ru/partners [R=301,L]
RewriteRule ^publichnaya-oferta/?$ https://termburg.ru/offer [R=301,L]
RewriteRule ^visiting-rules/?$ https://termburg.ru/rules [R=301,L]
RewriteRule ^services/bani-bochki/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/bassejn/?$ https://termburg.ru/pools [R=301,L]
RewriteRule ^services/hammam/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/individualnye-russkie-parnye/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/lipovaya-sauna/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/peschanaya-sauna/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/russkaya-parnaya/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/sauna-s-gimalajskoj-solyu/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^services/travyanaya-sauna/?$ https://termburg.ru/steam-rooms [R=301,L]
RewriteRule ^stranicza-bronirovaniya/?$ https://termburg.ru/services [R=301,L]
RewriteRule ^certificates/?$ https://termburg.ru/pricing [R=301,L]
RewriteRule ^gift_boxes/?$ https://termburg.ru/pricing [R=301,L]
RewriteRule ^kupit-onlajn/?$ https://termburg.ru/pricing [R=301,L]
RewriteRule ^price-abonements/?$ https://termburg.ru/pricing [R=301,L]
RewriteRule ^price-list/?$ https://termburg.ru/pricing [R=301,L]
RewriteRule ^product-category/(.*)$ https://termburg.ru/pricing [R=301,L]
RewriteRule ^product/individualnye-pareniya/?$ https://termburg.ru/services [R=301,L]
RewriteRule ^product/klassicheskij-massazh/?$ https://termburg.ru/services [R=301,L]
RewriteRule ^product/(.*)$ https://termburg.ru/pricing [R=301,L]

# Safe news redirect: только для несуществующих /news/article-name
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^news/(.+)$ https://termburg.ru/news [R=301,L]

RewriteRule ^school-par/?$ https://termburg.ru/steam-school [R=301,L]
RewriteRule ^timetable/?$ https://termburg.ru/schedule [R=301,L]
RewriteRule ^profitable-offer/?$ https://termburg.ru/promotions [R=301,L]
RewriteRule ^menyu-restorana/?$ https://termburg.ru/cafe [R=301,L]
RewriteRule ^job/?$ https://termburg.ru/careers [R=301,L]
RewriteRule ^vacancy/(.*)$ https://termburg.ru/careers [R=301,L]
RewriteRule ^reviews/?$ https://termburg.ru/ [R=301,L]

# Vite assets: если файла нет, отдаём 404, а не SPA index.html
RewriteRule ^assets/.+\.(js|css|map|json|woff2?|png|jpe?g|webp|svg|ico)$ - [L]

# Static files serve directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule . - [L]

# Prerender priority: если для URL есть статический /<route>/index.html — отдаём его
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# SPA fallback - everything else to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/tablet-sales/?$" termburg_tablet_sales_noindex=1
  Header always set X-Robots-Tag "noindex, nofollow" env=termburg_tablet_sales_noindex

  # HTML не кешируем, чтобы всегда подтягивался свежий build/index.html или /route/index.html
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Хэшированные Vite assets можно кешировать надолго
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# BEGIN WordPress
# Директивы (строки) между `BEGIN WordPress` и `END WordPress`
# созданы автоматически и подлежат изменению только через фильтры WordPress.
# Сделанные вручную изменения между этими маркерами будут перезаписаны.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
